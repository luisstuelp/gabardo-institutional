	}
	 
	if (@$_POST['op']=="sair") {
		$_SESSION["dn"]="";
	}

	if (@$_POST['dn']<>"") {

		$sql =  "Select *
				From
					VIEW_SIGA_CONSULTATRANSPORTE A
				Where
					A.LOGIN_DN = '" .@$_POST['dn']. "' or 
					A.DN = '" .@$_POST['dn']. "'";  
		//echo $sql;
		if ($result = $con->query($sql)) {
			if ($result->num_rows>0){
				$_SESSION["dn"]=$_POST['dn'];
			} else {
				$msg ="<br><br><center><strong>Login Inválido por favor entre em contato conosco</strong></center>";
			}
		}
	}
