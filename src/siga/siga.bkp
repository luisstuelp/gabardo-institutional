		<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDEJlzUECdkAUQ6Ad3BUlaQYAKRu9O5M7o"></script>
		<script>
			console.log('navigator.geolocation -14.799483, -55.675289');

			map = new google.maps.Map(document.getElementById('map'), {
			zoom: 4,
			center: new google.maps.LatLng(-14.799483, -55.675289),
			mapTypeId: 'roadmap'
			});

			var contentString = '';
			var infowindow = new google.maps.InfoWindow({content: contentString});

			var features = [
				<?php
					if (@$result = $con->query($sql)) {
						while ($row = $result->fetch_assoc()) {
							if ($row["LATITUDE"]<>"0" and $row["LONGITUDE"]<>"0"){
								?>
								{
								title: '<?=$row["LATITUDE"]?>, <?=$row["LONGITUDE"]?>',
								cte: '<?=$row["CTE"]?>',
								position: new google.maps.LatLng(<?=$row["LATITUDE"]?>, <?=$row["LONGITUDE"]?>),
								icon: 'caminhao.png',
								contentString: '<div class="google_box"><strong>Viagem:</strong> <?=$row["BAL_VIAGEM"]?><br><strong>CTE:</strong> <?=$row["BAL_CTE"]?><br><strong>Saída:</strong> <?=$row["BAL_DTSAIDA"]?><br><strong>Motorista:</strong> <?=$row["BAL_MOTORISTA"]?><br><strong>Frota:</strong> <?=$row["BAL_FROTA"]?><br><strong>Coleta:</strong> <?=$row["BAL_COLETA"]?><br><strong>Entrega:</strong> <?=$row["BAL_ENTREGA"]?><br><strong>Destinatário:</strong> <?=$row["BAL_DESTINATARIO"]?><br><strong>Atualização:</strong> <?=$row["BAL_DATAPOSICAO"]?><br></div>'
								},
								<?php
							}
						}
					}
				?>
			];

			var contentString = '';
			var infowindow = new google.maps.InfoWindow({content: contentString});
	
			//Adicionar os marcadores
			features.forEach(function(feature) {
				var marker = new google.maps.Marker({
					position: feature.position,
					map: map,
					title: feature.title,
					icon: feature.icon
				});
				if (feature.cte == "<?=$cte?>"){
					infowindow.setContent(feature.contentString)
					infowindow.open(map, marker);
				}
				marker.addListener('click', function() {
					var contentString = feature.contentString
					infowindow.setContent(contentString)
					infowindow.open(map, marker);

				});				
			}); 
				
			$(".tr-linha").click(function(){ 
				var c=$.attr(this, 'data-cte');

				console.log(".tr-linha cte:"+c)

				$("#cte").attr('value', c);
				$("#op").attr('value', "dados");
				frm.submit();        
				return false;
			}) 
		</script>
